# Copy to .env.test ONLY in the separate TEST checkout.
# Distinct from .env.test.example / compose.test.yaml (automated test runner).
# Generate TWO different values locally, e.g. openssl rand -hex 32 for each.
# Never copy PROD values. Empty required values deliberately fail config/start.
TEST_POSTGRES_PASSWORD=
TEST_AUTH_PROXY_SECRET=
# Optional exact username forwarded by the future trusted authentication proxy.
TEST_SUPERADMIN_USERNAME=
