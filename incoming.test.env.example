# Shared TEST / CodeServer LOCAL/DEV. Copy to incoming.test.env, never incoming.env.
# POSIX-shell and Compose env syntax; source only your reviewed, private file.
# Keep values of an existing TEST database unchanged when migrating this file.
POSTGRES_DB=incoming_test
POSTGRES_USER=incoming_test
# Existing TEST password, or generate a URL-safe hex secret for a NEW database.
POSTGRES_PASSWORD=
POSTGRES_HOST=incoming-test-postgres
POSTGRES_PORT=5432
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@incoming-test-postgres:5432/${POSTGRES_DB}"

# Existing TEST proxy secret; must match the trusted TEST auth gateway.
AUTH_PROXY_SECRET=
AUTH_DEV_USER=
AUTH_DEV_GROUPS=
SUPERADMIN_USERNAME=
FLASK_ENV=production
LOG_LEVEL=INFO
DATABASE_MAINTENANCE_MODE=false
OPERATIONAL_EVENT_ID=
CORS_ORIGINS=

# Same paths and service names in TEST containers and CodeServer.
# CodeServer also needs the SAME TEST backup volume at /backups, read-only.
BACKUP_DIR=/backups
BACKUP_SERVICE_URL=http://incoming-test-backup:8080
BACKUP_ENABLED=false
BACKUP_SCHEDULE='0 3 * * *'

# LOCAL/DEV: use the base-prefixed Vite proxy for the local backend.
# Docker frontend builds keep their own VITE_API_URL=/api.
VITE_API_URL=/absproxy/5173/api
VITE_API_PROXY_TARGET=http://127.0.0.1:5000

# LOCAL/DEV only: CodeServer port proxy; not passed to Docker frontend builds.
VITE_BASE_PATH=/absproxy/5173/
