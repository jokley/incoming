# Local launcher only. Never copy incoming.env or production credentials here.
# Plain KEY=value syntax; paths may contain spaces but must not be quoted.
DATABASE_URL=postgresql://incoming_test:incoming_test@127.0.0.1:55432/incoming_test
# Optional PostgreSQL 17 bin directory. Empty uses the PR3B portable installation
# under TEMP, or PostgreSQL tools already on PATH.
POSTGRES_BIN=
# Use Vite's existing /api proxy to the local backend.
VITE_API_URL=/api
# Optional reviewed restore configuration (see docs/LOCAL_RESTORE_VERIFICATION.md).
# Use a separate --env-file to keep the ordinary development target unchanged.
# DATABASE_URL may instead name incoming_restorecheck_YYYYMMDD_HHMMSS on the
# same loopback port with the same local role/password. Other targets are refused.
# BACKUP_PORT=8080
# OPERATIONAL_EVENT_ID=<explicit ID verified by the ownership preflight>
# EVENT_OWNERSHIP_PLAN=C:/absolute/path/to/reviewed/plan.json
