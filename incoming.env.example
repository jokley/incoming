# Copy this file to incoming.env and fill in production values.
# Keep incoming.env private; it is ignored by git.

# Flask/runtime
FLASK_ENV=development
APP_DATA_DIR=/app/data
# sqlite remains the default. Set both variables below only for a deliberate
# PostgreSQL deployment after the schema has been prepared.
DATABASE_BACKEND=sqlite
DATABASE_PATH=/app/data/freestyle_wm_new.db
# DATABASE_URL=postgresql://incoming:change-me@postgres:5432/incoming
LOG_LEVEL=INFO

# Local Docker PostgreSQL service. Use secret-managed values in production.
POSTGRES_DB=incoming
POSTGRES_USER=incoming
POSTGRES_PASSWORD=change-me

# Shared secret that must exactly match the Nginx X-Auth-Proxy-Secret header.
# Generate for example with: openssl rand -hex 32
AUTH_PROXY_SECRET=change-me

# Optional: enable CORS only when the frontend is served from a different origin.
# CORS_ORIGINS=https://incoming.jokley.at

# Local development only; never set these in production.
# AUTH_DEV_USER=dev.admin
# AUTH_DEV_GROUPS=incoming-admin
